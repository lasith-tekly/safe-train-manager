# Copy this to .env and fill in values before deployment

# JWT Security — CHANGE THIS in production!
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=amadeus-elevate-secret-2026-change-in-prod

# Token expiry
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — comma-separated list of allowed frontend origins
# Example: https://elevate.amadeus.com,https://safe-train.amadeus.net
ALLOWED_ORIGINS=

# Database (for future PostgreSQL migration)
DATABASE_URL=postgresql://user:password@host:5432/dbname
